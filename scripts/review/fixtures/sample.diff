+import type { APIRoute } from "astro";
+import { createClient } from "@/lib/supabase";
+
+export const prerender = false;
+
+// Search quotes by patient name or e-mail. Used by the new search box on the
+// admin list.
+export const GET: APIRoute = async (context) => {
+  const supabase = createClient(context.request.headers, context.cookies);
+  if (!supabase) {
+    return new Response("no supabase", { status: 500 });
+  }
+
+  const url = new URL(context.request.url);
+  const q = url.searchParams.get("q") || "";
+  const limit = Number(url.searchParams.get("limit") ?? "50");
+
+  const { data, error } = await supabase
+    .from("quotes")
+    .select("id, patient_name, patient_email, status, token, content")
+    .or(`patient_name.ilike.%${q}%,patient_email.ilike.%${q}%`)
+    .limit(limit);
+
+  if (error) {
+    console.log("search failed", error, q);
+    return new Response(JSON.stringify({ error: error.message }), { status: 500 });
+  }
+
+  return new Response(JSON.stringify({ quotes: data }), {
+    status: 200,
+    headers: { "Content-Type": "application/json" },
+  });
+};
