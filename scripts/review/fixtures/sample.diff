+import { useEffect, useState } from "react";
+
+interface Quote {
+  id: string;
+  patient_name: string;
+  patient_email: string | null;
+  token: string | null;
+}
+
+export function QuoteSearchBox() {
+  const [q, setQ] = useState("");
+  const [results, setResults] = useState<Quote[]>([]);
+
+  useEffect(() => {
+    fetch("/api/admin/quotes/search?q=" + q)
+      .then((r) => r.json())
+      .then((d) => setResults(d.quotes));
+  }, [q]);
+
+  return (
+    <div className={"flex flex-col gap-2 " + (results.length ? "pb-4" : "")}>
+      <input value={q} onChange={(e) => setQ(e.target.value)} placeholder="Szukaj pacjenta" />
+      {results.map((r) => (
+        <a key={r.id} href={`/p/${r.token}`}>{r.patient_name} — {r.patient_email}</a>
+      ))}
+    </div>
+  );
+}
