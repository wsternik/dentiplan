---
import "@fontsource-variable/literata/standard.css";
import "@fontsource-variable/archivo/wght.css";
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs, publicMissingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
  /** Document language; Polish, which is what every page in the product is. */
  lang?: string;
}

const { title = "DentiPlan", lang = "pl" } = Astro.props;

// This layout is shared with the anonymous patient page, so an admin-only
// configuration banner would be shown to whoever opened the quote link — the
// one thing `/p/<token>` promises never to do (FR-060, no-disclosure).
const banners = Astro.locals.user ? missingConfigs : publicMissingConfigs;

// NOTHING PER-REQUEST BELONGS IN THIS FILE. `e2e/patient-link-probe.spec.ts`
// asserts that two different bad tokens produce byte-identical responses, and
// this layout wraps that page. A nonce, a generated id, or a rendered timestamp
// added here breaks a security test, which is a confusing way to find out.
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    {
      banners.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
