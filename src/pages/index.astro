---
// The front door. Anonymous: nothing here is derived from a session, and the
// sample below is invented — round numbers, no real patient, no real pricelist
// lookup.
//
// The page states rather than sells. Three readers arrive: the dentist, who
// wants the sign-in button where convention puts it; a stranger who trimmed a
// `/p/<token>` link to its root and needs to know what this is and who it is
// for; and nobody else. So there is exactly one action on the whole page, and
// the only thing given any weight is the artifact — a diagnosis note next to the
// page it becomes.
//
// There is no sign-up, on any level, and there must never be: RLS grants every
// authenticated role full CRUD on `public.quotes`, so a new account would be a
// dentist account. `e2e/home.spec.ts` guards this page's half of that.

import Layout from "@/layouts/Layout.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import SampleQuote from "@/components/home/SampleQuote.astro";

// `buttonVariants` is a pure `cva` call, so the header's one link is rendered to
// HTML and ships no JavaScript. The button component itself is not imported.
const signInClass = cn(buttonVariants());

const description =
  "DentiPlan zamienia notatkę dentysty z konsultacji w plan leczenia z dwoma kosztorysami: w kilku wizytach albo w jednej sesji w narkozie. Pacjent otwiera go jednym linkiem, bez konta.";
---

<Layout title="DentiPlan — kosztorys leczenia dla pacjenta">
  <Fragment slot="head">
    <meta name="description" content={description} />
  </Fragment>

  <div class="flex min-h-screen flex-col">
    {
      /* The wordmark is a plain `<span>`: this page is the root, so linking it
        would give the page a second link pointing at itself. */
    }
    <header class="border-border border-b">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-3 sm:px-6">
        <span class="text-base leading-none font-semibold tracking-tight">DentiPlan</span>
        <a href="/auth/signin" class:list={signInClass}>Zaloguj się</a>
      </div>
    </header>

    <main class="mx-auto w-full max-w-5xl grow px-5 pb-8 sm:px-6">
      {
        /* The wrap belongs to the browser, not to markup — a hard `<br>` here
          stranded one word on a desktop line. `text-balance` plus a measure cap
          does the same job at every width. */
      }
      <h1
        class="mt-10 max-w-[26ch] font-serif text-[1.9375rem] leading-[1.15] font-medium tracking-tight text-balance lg:mt-12 lg:text-[2.4375rem]"
      >
        Notatka z konsultacji staje się planem leczenia i kosztorysem dla pacjenta.
      </h1>

      {
        /* Full ink, not slate: this is the sentence that explains the product,
          so it must not be the least legible thing on the page. */
      }
      <p class="mt-6 max-w-[60ch] text-base leading-[1.6] lg:text-[1.0625rem]">
        DentiPlan to narzędzie gabinetu stomatologicznego. Dentystka wkleja notatkę z rozpoznania, sprawdza wypełniony
        formularz i zatwierdza. Pacjent otwiera link i widzi to samo leczenie policzone na dwa sposoby: rozłożone na
        wizyty albo w jednej sesji w narkozie.
      </p>

      <SampleQuote />
    </main>

    <footer class="border-border border-t">
      <div class="mx-auto max-w-5xl px-5 py-4 sm:px-6">
        <p class="text-muted-foreground text-xs leading-[1.5]">
          Z DentiPlanu korzysta gabinet. Pacjent nie potrzebuje konta, wystarczy link.
        </p>
      </div>
    </footer>
  </div>
</Layout>
