---
// The public front door is deliberately data-free. The sample plan is rendered
// from invented constants inside the illustration; nothing here reads a
// session, quote, token, database row, or current price list.
import TreatmentPlanIllustration from "@/components/home/TreatmentPlanIllustration.astro";
import Wordmark from "@/components/Wordmark.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="DentiPlan — jasny plan, spokojny pacjent">
  <div class="shell-marketing">
    <header class="flex min-h-20 items-center justify-between gap-4 border-b py-4 lg:min-h-[6.625rem]">
      <Wordmark href="/" />

      <nav aria-label="Główna nawigacja" class="flex items-center gap-5 text-xs font-semibold lg:gap-9">
        <a
          href="#jak-to-dziala"
          class="hover:text-brand-ink focus-visible:ring-ring hidden rounded-sm transition-colors focus-visible:ring-2 focus-visible:outline-none sm:inline"
        >
          Jak to działa
        </a>
        <a
          href="#dla-pacjenta"
          class="hover:text-brand-ink focus-visible:ring-ring hidden rounded-sm transition-colors focus-visible:ring-2 focus-visible:outline-none sm:inline"
        >
          Dla pacjenta
        </a>
        <a
          href="/auth/signin"
          class="border-foreground/20 hover:border-foreground/40 focus-visible:ring-ring inline-flex min-h-11 items-center gap-3 rounded-full border px-4 transition-colors focus-visible:ring-2 focus-visible:outline-none"
        >
          Panel gabinetu
          <svg class="size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="4" y="4" width="6" height="6" rx="1.4"></rect>
            <rect x="14" y="4" width="6" height="6" rx="1.4"></rect>
            <rect x="4" y="14" width="6" height="6" rx="1.4"></rect>
            <rect x="14" y="14" width="6" height="6" rx="1.4"></rect>
          </svg>
        </a>
      </nav>
    </header>

    <main>
      <div class="grid items-center gap-10 py-11 lg:grid-cols-2 lg:gap-8 lg:py-[4.625rem] xl:gap-16">
        <section aria-labelledby="home-title" class="max-w-[38rem]">
          <p class="flex items-center gap-2.5 text-[0.6875rem] font-bold tracking-[0.16em] uppercase">
            <span class="bg-brand size-2 rounded-full" aria-hidden="true"></span>
            Od diagnozy do zrozumienia
          </p>

          <h1
            id="home-title"
            class="mt-6 text-[clamp(3.05rem,6.1vw,4.375rem)] leading-[1.06] font-medium tracking-[-0.055em]"
          >
            Twoja diagnoza.<br />Jasny plan.
            <span class="text-brand-ink block font-semibold tracking-[-0.05em]">Spokojny pacjent.</span>
          </h1>

          <p class="text-muted-foreground mt-6 max-w-[30rem] text-sm leading-7 sm:text-base">
            <strong class="text-foreground font-semibold">Zamień notatkę z diagnozy w czytelny plan leczenia.</strong>
            DentiPlan porządkuje zabiegi, zestawia koszty dwóch wariantów i zamyka wszystko w jednym linku dla pacjenta.
          </p>

          <div class="mt-7 flex flex-wrap items-center gap-4 sm:gap-6">
            <a
              href="/auth/signin"
              class="bg-primary text-primary-foreground hover:bg-primary/90 focus-visible:ring-ring inline-flex min-h-13 items-center gap-5 rounded-full py-2 pr-2 pl-5 text-xs font-bold shadow-[0_3px_0_color-mix(in_oklch,var(--foreground)_7%,transparent)] transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
            >
              Przejdź do gabinetu
              <span class="grid size-9 place-items-center rounded-full bg-white/10" aria-hidden="true">
                <svg class="size-[1.125rem]" viewBox="0 0 24 24" fill="none">
                  <rect x="4" y="4" width="6" height="6" rx="1.4"></rect>
                  <rect x="14" y="4" width="6" height="6" rx="1.4"></rect>
                  <rect x="4" y="14" width="6" height="6" rx="1.4"></rect>
                  <rect x="14" y="14" width="6" height="6" rx="1.4"></rect>
                </svg>
              </span>
            </a>
            <a
              href="#dla-pacjenta"
              class="text-muted-foreground hover:text-foreground focus-visible:ring-ring inline-flex items-center gap-2 rounded-sm py-3 text-xs font-bold transition-colors focus-visible:ring-2 focus-visible:outline-none"
            >
              <svg class="text-brand-ink size-[1.125rem]" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              Zobacz przykładowy plan
            </a>
          </div>

          <p class="text-muted-foreground mt-4 flex items-center gap-2 text-xs">
            <span aria-hidden="true">✓</span> Pacjent otwiera plan bez konta i logowania.
          </p>
        </section>

        <section id="dla-pacjenta" aria-label="Dla pacjenta" class="min-w-0 scroll-mt-6">
          <TreatmentPlanIllustration />
        </section>
      </div>

      <div class="grid border-y py-1 sm:grid-cols-3 sm:py-5" aria-label="Droga od diagnozy do planu">
        <div class="flex items-center gap-4 border-b py-4 sm:border-r sm:border-b-0 sm:px-5 sm:py-0 sm:first:pl-0">
          <span class="text-brand-ink text-3xl font-medium tracking-[-0.06em]">01</span>
          <p class="m-0 text-xs leading-5">
            Notatka od lekarza<br /><span class="text-muted-foreground">Punkt wyjścia do planu</span>
          </p>
        </div>
        <div class="flex items-center gap-4 border-b py-4 sm:border-r sm:border-b-0 sm:px-5 sm:py-0">
          <span class="text-brand-ink text-3xl font-medium tracking-[-0.06em]">02</span>
          <p class="m-0 text-xs leading-5">
            Warianty kosztorysu<br /><span class="text-muted-foreground">Standardowo lub w narkozie</span>
          </p>
        </div>
        <div class="flex items-center gap-4 py-4 sm:px-5 sm:py-0 sm:pr-0">
          <span class="text-brand-ink text-3xl font-medium" aria-hidden="true">↗</span>
          <p class="m-0 text-xs leading-5">
            Jeden link dla pacjenta<br /><span class="text-muted-foreground">Na telefonie, komputerze i papierze</span>
          </p>
        </div>
      </div>

      <section id="jak-to-dziala" aria-labelledby="how-heading" class="scroll-mt-6 py-14 lg:py-20">
        <div class="grid items-end gap-6 md:grid-cols-[minmax(0,1fr)_20rem] md:gap-10">
          <div>
            <p class="flex items-center gap-2.5 text-[0.6875rem] font-bold tracking-[0.16em] uppercase">
              <span class="bg-brand size-2 rounded-full" aria-hidden="true"></span>
              Prościej po konsultacji
            </p>
            <h2 id="how-heading" class="font-editorial mt-4 text-4xl leading-tight font-medium tracking-[-0.035em]">
              Ty znasz diagnozę.<br />My pomagamy ją uporządkować.
            </h2>
          </div>
          <p class="text-muted-foreground m-0 text-sm leading-7">
            Mniej przepisywania i liczenia. Więcej przestrzeni na rozmowę o tym, co naprawdę ważne dla pacjenta.
          </p>
        </div>

        <div class="mt-10 grid gap-7 md:grid-cols-3 md:gap-8">
          <article class="border-t pt-5">
            <div class="text-muted-foreground flex items-center justify-between text-[0.6875rem]">
              <span class="text-brand-ink font-semibold">01 / NOTATKA</span><span class="text-2xl" aria-hidden="true"
                >≡</span
              >
            </div>
            <h3 class="mt-5 text-xl font-semibold tracking-[-0.025em]">Zacznij od tego, co masz.</h3>
            <p class="text-muted-foreground mt-3 text-sm leading-7">
              Wklej notatkę z rozpoznaniem. DentiPlan odczyta zęby i zabiegi, tworząc podstawę planu do Twojej
              weryfikacji.
            </p>
          </article>
          <article class="border-t pt-5">
            <div class="text-muted-foreground flex items-center justify-between text-[0.6875rem]">
              <span class="text-brand-ink font-semibold">02 / TWÓJ PLAN</span><span class="text-2xl" aria-hidden="true"
                >⊞</span
              >
            </div>
            <h3 class="mt-5 text-xl font-semibold tracking-[-0.025em]">Sprawdź. Uzupełnij. Zatwierdź.</h3>
            <p class="text-muted-foreground mt-3 text-sm leading-7">
              Ustal zakres i wizyty. Porównaj koszt leczenia standardowego z leczeniem w narkozie. Każda decyzja
              pozostaje po Twojej stronie.
            </p>
          </article>
          <article class="border-t pt-5">
            <div class="text-muted-foreground flex items-center justify-between text-[0.6875rem]">
              <span class="text-brand-ink font-semibold">03 / JASNOŚĆ DLA PACJENTA</span>
              <span class="text-2xl" aria-hidden="true">↗</span>
            </div>
            <h3 class="mt-5 text-xl font-semibold tracking-[-0.025em]">Przekaż więcej niż wycenę.</h3>
            <p class="text-muted-foreground mt-3 text-sm leading-7">
              Udostępnij link do planu, do którego pacjent może spokojnie wrócić. Z zakresem leczenia, etapami i
              kosztami obok siebie.
            </p>
          </article>
        </div>
      </section>

      <section
        class="bg-primary text-primary-foreground mb-9 flex flex-col gap-7 rounded-xl px-6 py-8 md:mb-14 md:flex-row md:items-center md:justify-between md:px-11 md:py-10"
      >
        <div>
          <h2 class="font-editorial text-3xl font-medium tracking-[-0.03em]">
            Dobra rozmowa zaczyna się od jasnego planu.
          </h2>
          <p class="mt-2 text-xs leading-5 text-white/70">
            DentiPlan porządkuje Twoją diagnozę. Decyzje medyczne należą do Ciebie.
          </p>
        </div>
        <a
          href="/auth/signin"
          class="text-foreground focus-visible:ring-ring inline-flex min-h-13 w-fit shrink-0 items-center gap-5 rounded-full bg-[#f1ad96] py-2 pr-2 pl-5 text-xs font-bold transition-colors hover:bg-[#f5bda9] focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
        >
          Otwórz panel gabinetu
          <span class="grid size-9 place-items-center rounded-full bg-black/5" aria-hidden="true">
            <svg class="size-[1.125rem]" viewBox="0 0 24 24" fill="none">
              <rect x="4" y="4" width="6" height="6" rx="1.4"></rect>
              <rect x="14" y="4" width="6" height="6" rx="1.4"></rect>
              <rect x="4" y="14" width="6" height="6" rx="1.4"></rect>
              <rect x="14" y="14" width="6" height="6" rx="1.4"></rect>
            </svg>
          </span>
        </a>
      </section>
    </main>

    <footer class="flex items-start justify-between gap-7 border-t py-6 text-xs">
      <Wordmark compact />
      <p class="text-muted-foreground m-0 max-w-sm text-right leading-5">
        Od notatki lekarza do planu zrozumiałego dla pacjenta.
      </p>
    </footer>
  </div>
</Layout>

<style>
  svg {
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
