---
// Open one quote from the list (S-03, FR-071).
//
// Drafts come back editable; approved quotes render the same layout with every
// mutating control gone (FR-053) and their `/p/<token>` link ready to copy —
// one component and one layout, so the two views cannot drift apart.
//
// `content` is parsed through `QuoteContentSchema` before it reaches the island,
// so a malformed stored tree fails here at the boundary rather than somewhere
// inside React. The DB default is `'{}'::jsonb` and every top-level collection in
// the schema has a default, so a brand-new draft parses fine.

import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import QuoteEditor from "@/components/admin/QuoteEditor";
import { buildPickerOptions } from "@/lib/pricing";
import { createClient } from "@/lib/supabase";
import { PatientTypeSchema, QuoteContentSchema, QuoteStatusSchema } from "@/types";
import { z } from "zod";

export const prerender = false;

const { toothOptions, generalOptions } = buildPickerOptions();

// Untyped Supabase client — funnel the row through Zod rather than trusting `any`
// (same convention as `src/pages/p/[token].astro`).
const QuoteRowSchema = z.object({
  id: z.uuid(),
  patient_type: PatientTypeSchema,
  patient_email: z.string().nullable(),
  diagnosis_note: z.string().nullable(),
  status: QuoteStatusSchema,
  token: z.string().nullable(),
  content: QuoteContentSchema,
});

const id = z.uuid().safeParse(Astro.params.id);
const supabase = createClient(Astro.request.headers, Astro.cookies);

let quote: z.infer<typeof QuoteRowSchema> | null = null;
if (id.success && supabase) {
  const { data } = await supabase
    .from("quotes")
    .select("id, patient_type, patient_email, diagnosis_note, status, token, content")
    .eq("id", id.data)
    .maybeSingle();
  const parsed = QuoteRowSchema.safeParse(data);
  if (parsed.success) {
    quote = parsed.data;
  }
}
---

<Layout title={quote ? "Kosztorys" : "Nie znaleziono"}>
  <Topbar />
  <main class="min-h-[calc(100svh-3.75rem)]">
    {
      quote ? (
        <QuoteEditor
          toothOptions={toothOptions}
          generalOptions={generalOptions}
          quoteId={quote.id}
          initialContent={quote.content}
          initialPatientType={quote.patient_type}
          initialPatientEmail={quote.patient_email}
          initialDiagnosisNote={quote.diagnosis_note}
          readOnly={quote.status === "approved"}
          patientToken={quote.token}
          client:load
        />
      ) : (
        <div class="shell-workspace py-10 sm:py-16">
          <section class="border-border bg-card max-w-2xl rounded-2xl border p-6 sm:p-9">
            <span class="bg-brand mb-4 block h-1 w-10 rounded-full" aria-hidden="true" />
            <h1 class="font-editorial text-2xl font-medium tracking-[-0.03em] sm:text-3xl">
              Nie znaleziono kosztorysu
            </h1>
            <p class="text-muted-foreground mt-3 max-w-prose text-sm leading-relaxed">
              Ten kosztorys nie istnieje albo został usunięty.
            </p>
            <a
              href="/admin"
              class="border-border bg-card hover:bg-accent focus-visible:ring-ring mt-7 inline-flex h-10 items-center rounded-full border px-5 text-sm font-semibold tracking-tight transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
            >
              Lista kosztorysów
            </a>
          </section>
        </div>
      )
    }
  </main>
</Layout>
