---
// Admin quote list (S-03, FR-070). The panel's entry point: every quote the
// dentystka has made, newest first, with the recipient's e-mail so she knows who
// each link went to.
//
// Server-rendered on purpose — the only interactive element is the delete
// control, which is its own small island. `content` is deliberately NOT selected:
// the list renders none of it, and shipping quote trees the page never uses would
// be pure waste (and, for approved quotes, a needless copy of patient-visible
// data on an admin screen).
//
// The identifier links to `/admin/quotes/[id]` (FR-071): drafts open editable,
// approved quotes open read-only.

import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { DeleteQuoteButton } from "@/components/admin/DeleteQuoteButton";
import { Badge } from "@/components/ui/badge";
import { createClient } from "@/lib/supabase";
import { z } from "zod";

export const prerender = false;

// `/admin` is gated by middleware (PROTECTED_ROUTES). The signed-in address is
// the Topbar's job now — it was repeated by hand on all three admin pages.

// The Supabase client is untyped (no `Database` generic), so the result is
// funnelled through a Zod schema rather than trusted as `any` — same convention
// as the patient page's RPC call in `src/pages/p/[token].astro`.
const QuoteRowSchema = z.object({
  id: z.uuid(),
  patient_email: z.string().nullable(),
  created_at: z.string(),
  status: z.enum(["draft", "approved"]),
});

const supabase = createClient(Astro.request.headers, Astro.cookies);
let quotes: z.infer<typeof QuoteRowSchema>[] = [];
let loadError = false;

if (supabase) {
  // Ordered by `created_at desc` — served by `quotes_created_at_idx`. No
  // pagination: the PRD scales this at a few dozen quotes a year.
  const { data, error } = await supabase
    .from("quotes")
    .select("id, patient_email, created_at, status")
    .order("created_at", { ascending: false });
  const parsed = z.array(QuoteRowSchema).safeParse(data);
  if (error || !parsed.success) {
    loadError = true;
  } else {
    quotes = parsed.data;
  }
} else {
  loadError = true;
}

const dateFormatter = new Intl.DateTimeFormat("pl-PL", { dateStyle: "medium", timeStyle: "short" });
const formatDate = (iso: string) => dateFormatter.format(new Date(iso));
/** Short, stable handle for a row — the full uuid is noise on screen. */
const shortId = (id: string) => id.slice(0, 8);
---

<Layout title="Kosztorysy">
  <Topbar />

  <main class="shell-workspace py-8 sm:py-12">
    <div class="border-border mb-7 flex flex-wrap items-end justify-between gap-5 border-b pb-6 sm:mb-9">
      <div>
        <span class="bg-brand mb-3 block h-1 w-10 rounded-full" aria-hidden="true"></span>
        <h1 class="font-editorial text-3xl font-medium tracking-[-0.035em] sm:text-4xl">Kosztorysy</h1>
        <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
          Najnowsze na górze. Szkice otwierają się do edycji.
        </p>
      </div>
      <a
        href="/admin/quotes/new"
        class="bg-primary text-primary-foreground hover:bg-primary/88 focus-visible:ring-ring inline-flex h-10 shrink-0 items-center rounded-full px-5 text-sm font-semibold tracking-tight transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
      >
        Nowy kosztorys
      </a>
    </div>

    {
      loadError && (
        <div role="alert" class="border-destructive/30 bg-card rounded-2xl border p-6 sm:p-8">
          <span class="bg-destructive mb-4 block size-2 rounded-full" aria-hidden="true" />
          <p class="font-editorial text-destructive text-xl font-medium sm:text-2xl">
            Nie udało się wczytać listy kosztorysów.
          </p>
        </div>
      )
    }

    {
      !loadError && quotes.length === 0 && (
        <div class="border-border bg-card rounded-2xl border p-6 sm:p-9">
          <span class="bg-brand mb-4 block h-1 w-8 rounded-full" aria-hidden="true" />
          <p class="font-editorial text-xl font-medium tracking-[-0.025em] sm:text-2xl">Brak kosztorysów</p>
          <p class="text-muted-foreground mt-2 max-w-prose text-sm leading-relaxed">
            Nie masz jeszcze żadnych kosztorysów. Zacznij od „Nowy kosztorys” — wklej notatkę z diagnozy, sprawdź
            formularz i zatwierdź.
          </p>
        </div>
      )
    }

    {
      quotes.length > 0 && (
        <div class="border-border bg-card overflow-hidden rounded-2xl border shadow-[0_18px_50px_-42px_color-mix(in_oklch,var(--foreground)_38%,transparent)]">
          <div class="overflow-x-auto">
            <table class="w-full min-w-[44rem] text-left text-sm">
              <thead class="bg-secondary/55">
                <tr class="border-border text-muted-foreground border-b">
                  <th class="px-4 py-3 font-semibold">Identyfikator</th>
                  <th class="px-4 py-3 font-semibold">E-mail odbiorcy</th>
                  <th class="px-4 py-3 font-semibold">Utworzono</th>
                  <th class="px-4 py-3 font-semibold">Status</th>
                  <th class="px-4 py-3 font-semibold" />
                </tr>
              </thead>
              <tbody>
                {quotes.map((quote) => (
                  <tr class="border-border hover:bg-secondary/35 border-b transition-colors last:border-b-0">
                    {/* Monospace here is earned: this is eight hex characters a
                      human compares by eye against a link or another row. */}
                    <td class="px-4 py-3 font-mono">
                      <a
                        href={`/admin/quotes/${quote.id}`}
                        class="decoration-brand-ink/55 hover:decoration-brand-ink underline decoration-2 underline-offset-4 transition-colors"
                      >
                        {shortId(quote.id)}
                      </a>
                    </td>
                    <td class="px-4 py-3">{quote.patient_email ?? <span class="text-muted-foreground">—</span>}</td>
                    <td class="numeric text-muted-foreground px-4 py-3 whitespace-nowrap">
                      {formatDate(quote.created_at)}
                    </td>
                    <td class="px-4 py-3">
                      {/* The draft is the row that still wants something from
                        her, so it carries the weight; an approved quote is
                        finished and can be quiet. Most rows are approved, and a
                        column of solid pills would say nothing. */}
                      <Badge variant={quote.status === "approved" ? "outline" : "default"}>
                        {quote.status === "approved" ? "Zatwierdzony" : "Szkic"}
                      </Badge>
                    </td>
                    <td class="px-4 py-3 text-right">
                      {quote.status === "draft" && <DeleteQuoteButton id={quote.id} client:load />}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )
    }
  </main>
</Layout>
