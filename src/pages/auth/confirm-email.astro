---
import Layout from "@/layouts/Layout.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      heading: "Registration successful",
      description: "Your account has been created. You can now sign in.",
      linkText: "Go to sign in",
    }
  : {
      heading: "Check your email",
      description: "We've sent a confirmation link to your email address. Click it to activate your account.",
      linkText: "Back to sign in",
    };
---

<Layout title={content.heading} lang="en">
  <main class="flex min-h-screen flex-col items-center justify-center px-5 py-12">
    <a href="/" class="text-muted-foreground mb-8 text-sm font-medium tracking-tight">DentiPlan</a>
    <div class="border-border bg-card w-full max-w-sm rounded-md border p-7">
      <h1 class="font-serif text-xl font-medium tracking-tight">{content.heading}</h1>
      <p class="text-muted-foreground mt-3 text-sm leading-relaxed">{content.description}</p>
      <a href="/auth/signin" class="text-foreground mt-6 inline-block text-sm underline underline-offset-4">
        {content.linkText}
      </a>
    </div>
  </main>
</Layout>
