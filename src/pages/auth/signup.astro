---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign up">
  <main class="flex min-h-screen flex-col items-center justify-center px-5 py-12">
    <a href="/" class="text-muted-foreground mb-8 text-sm font-medium tracking-tight">DentiPlan</a>
    <div class="border-border bg-card w-full max-w-sm rounded-md border p-7">
      <h1 class="mb-6 font-serif text-xl font-medium tracking-tight">Sign up</h1>
      <SignUpForm serverError={error} client:load />
    </div>
    <p class="text-muted-foreground mt-6 text-sm">
      Already have an account? <a href="/auth/signin" class="text-foreground underline underline-offset-4">Sign in</a>
    </p>
  </main>
</Layout>
