---
// The dentist's own door. Copy stays in English: `Email`, `Password` and
// `Sign in` are the accessible names `e2e/auth.setup.ts` locates by, and this
// redesign does not move a test contract for tidiness.
//
// Hence `lang="en"`. The layout defaults to Polish, which is right for every
// page a patient sees — but declaring Polish around English text tells a screen
// reader to pronounce it with Polish rules.
//
// No sign-up link, and no sign-up route behind it: the practice runs on one
// account, created by hand in Supabase (prd.md, "Panel dentystki"). A door with
// a "create your own key" sign next to it is the wrong door.

import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import Wordmark from "@/components/Wordmark.astro";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in" lang="en">
  <main class="shell-workspace flex min-h-screen items-center justify-center py-10 sm:py-16">
    <div class="w-full max-w-md">
      <Wordmark href="/" class="mb-8" />
      <section
        class="border-border bg-card rounded-2xl border p-6 shadow-[0_24px_70px_-42px_color-mix(in_oklch,var(--foreground)_42%,transparent)] sm:p-8"
      >
        <div class="border-border mb-7 border-b pb-6">
          <span class="bg-brand mb-4 block h-1 w-10 rounded-full" aria-hidden="true"></span>
          <h1 class="font-editorial text-3xl font-medium tracking-[-0.035em]">Sign in</h1>
        </div>
        <SignInForm serverError={error} client:load />
      </section>
    </div>
  </main>
</Layout>
