---
// A full-width notice above the page. Off its hardcoded hex palette and onto the
// tokens, so a configuration warning looks like part of the product rather than
// like a browser error.
//
// The `error` variant borrows the urgency red: in this palette a colour is
// always saying something, and this one is saying the same thing an urgent tooth
// says.

type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;

const tone: Record<Variant, string> = {
  info: "bg-secondary text-foreground border-border",
  warning: "bg-urgency-moderate/12 text-urgency-moderate-ink border-urgency-moderate/40",
  error: "bg-urgency-urgent/10 text-urgency-urgent-ink border-urgency-urgent/40",
};
---

<div
  class:list={[
    "border-b text-center text-sm [&_a]:font-medium [&_a]:underline [&_a]:underline-offset-2",
    tone[variant],
  ]}
  role={variant === "error" ? "alert" : "status"}
>
  <div class="shell-workspace py-2.5">
    <slot />
  </div>
</div>
