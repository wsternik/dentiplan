---
// The panel's chrome: wordmark, who is signed in, and the way out. Phase 3 puts
// it on the three admin pages, each of which currently repeats its own
// `Zalogowano: {user.email}` line.
//
// Two things this deliberately does NOT contain, both because the E2E suite
// locates against the whole page under strict mode:
//
//   - a link named "Nowy kosztorys" — `seed.spec.ts` clicks that name on
//     `/admin`, and a second match makes the locator ambiguous;
//   - any textbox — `patient-link-content.spec.ts` reads an unqualified
//     `getByRole("textbox")` on the approval confirmation and expects exactly one.
//
// Admin-only, so there is no signed-out branch: every page that renders this is
// behind `PROTECTED_ROUTES`.

const { user } = Astro.locals;
---

<header class="border-border bg-background/95 no-print sticky top-0 z-20 border-b backdrop-blur-sm">
  <div class="mx-auto flex max-w-[1360px] items-baseline justify-between gap-4 px-4 py-3 sm:px-6">
    <a
      href="/admin"
      class="text-foreground focus-visible:ring-ring rounded-xs text-base font-semibold tracking-tight focus-visible:ring-2 focus-visible:outline-none"
    >
      DentiPlan
    </a>
    {
      user && (
        <div class="text-muted-foreground flex items-baseline gap-4 text-xs">
          <span class="hidden sm:inline">{user.email}</span>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="hover:text-foreground focus-visible:ring-ring rounded-xs underline-offset-4 transition-colors hover:underline focus-visible:ring-2 focus-visible:outline-none"
            >
              Wyloguj
            </button>
          </form>
        </div>
      )
    }
  </div>
</header>
