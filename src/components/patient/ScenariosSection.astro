---
// "Scenariusze, które mogą zmienić koszt" (FR-063): uncertain teeth with their
// notes, plus any range-driven upside. Per the FR-026 resolution the variant
// headlines show the lower bound ("od X zł"); the upper bound is a scenario that
// may raise the cost and is surfaced here rather than printed everywhere. The
// whole section is omitted when there is nothing uncertain and no range upside.
//
// The section carries `aria-labelledby` pointing at its own `<h2>`: a
// `<section>` with no accessible name is not exposed as a landmark, and these
// three lists are how a patient using a screen reader navigates this document.
//
// Uncertainty is drawn as a dashed rule — the same treatment the editor gives an
// uncertain tooth row, and one that survives being printed in black and white.

import type { QuoteTotals, ToothEntry } from "@/types";
import { toothName } from "@/lib/quote/tooth-name";
import { formatAmount, hasRangeUpside } from "@/lib/quote/format";

interface Props {
  uncertain: ToothEntry[];
  totals?: QuoteTotals;
}

const { uncertain, totals } = Astro.props;
const sorted = [...uncertain].sort((a, b) => a.number - b.number);

const grandTotal = totals?.standard?.grandTotal;
const showRangeUpside = grandTotal ? hasRangeUpside(grandTotal) : false;
const show = sorted.length > 0 || showRangeUpside;
---

{
  show && (
    <section class="border-border/80 bg-card space-y-3 rounded-2xl border p-5" aria-labelledby="scenariusze-heading">
      <div>
        <h2 id="scenariusze-heading" class="font-editorial text-2xl font-medium tracking-[-0.025em]">
          Scenariusze, które mogą zmienić koszt
        </h2>
        <div class="border-border mt-2 border-t border-dashed" />
      </div>
      <ul class="max-w-[68ch] space-y-2.5 text-sm">
        {showRangeUpside && grandTotal && (
          <li>
            W zależności od ostatecznego zakresu leczenia koszt może wzrosnąć do{" "}
            <span class="numeric whitespace-nowrap">{formatAmount(grandTotal.max)}</span>.
          </li>
        )}
        {sorted.map((tooth) => (
          <li>
            {toothName(tooth.number)}
            {tooth.note ? (
              <span class="text-muted-foreground"> — {tooth.note}</span>
            ) : (
              <span class="text-muted-foreground"> — możliwe dodatkowe leczenie</span>
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}
