---
// Quadrant-grouped in-plan tooth list (FR-061). Teeth are bucketed by FDI
// quadrant (first digit; permanent 1–4 and milk 5–8 share a side/jaw) and each
// row shows number + Polish name + treatment + urgency. Empty groups are
// dropped so the grid only shows quadrants that actually have teeth.
//
// Quadrants are laid out two to a row in chart reading order — upper before
// lower, right before left within a jaw — and this is the block S-06 replaces
// with the drawing itself. It is NOT a faithful 2×2 chart: empty quadrants are
// dropped, so two populated quadrants sit side by side whatever their jaw. That
// is right for a list and wrong for a chart, which is exactly the difference
// S-06 exists to close.

import type { ToothEntry, Urgency } from "@/types";
import { toothName } from "@/lib/quote/tooth-name";
import { TREATMENT_LABELS, URGENCY_LABELS } from "@/lib/quote/labels";

interface Props {
  teeth: ToothEntry[];
}

const { teeth } = Astro.props;

// Tailwind resolves class names at build time, so this is a lookup rather than
// an interpolated string. Same marks the editor's tooth rows use.
const URGENCY_MARK: Record<Urgency, string> = {
  urgent: "bg-urgency-urgent",
  moderate: "bg-urgency-moderate",
  mild: "bg-urgency-mild",
};

const GROUPS: { label: string; quadrants: number[] }[] = [
  { label: "Górne prawe", quadrants: [1, 5] },
  { label: "Górne lewe", quadrants: [2, 6] },
  { label: "Dolne lewe", quadrants: [3, 7] },
  { label: "Dolne prawe", quadrants: [4, 8] },
];

const grouped = GROUPS.map((group) => ({
  label: group.label,
  teeth: teeth
    .filter((tooth) => group.quadrants.includes(Math.floor(tooth.number / 10)))
    .sort((a, b) => a.number - b.number),
})).filter((group) => group.teeth.length > 0);
---

<section class="space-y-5">
  <h2 class="text-xl font-medium tracking-tight">Zakres leczenia</h2>

  <div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
    {
      grouped.map((group) => (
        <div>
          <h3 class="text-muted-foreground border-border border-b pb-1.5 font-sans text-xs font-medium">
            {group.label}
          </h3>
          <ul class="mt-3 space-y-2.5">
            {group.teeth.map((tooth) => (
              <li class="flex items-baseline gap-2.5 text-sm">
                {tooth.urgency && (
                  <span
                    aria-hidden="true"
                    class:list={["mt-1.5 size-2 shrink-0 rounded-full", URGENCY_MARK[tooth.urgency]]}
                  />
                )}
                <span>
                  {toothName(tooth.number)}
                  {(tooth.treatmentType ?? tooth.urgency) && (
                    <span class="text-muted-foreground block font-sans text-xs">
                      {tooth.treatmentType && TREATMENT_LABELS[tooth.treatmentType]}
                      {tooth.treatmentType && tooth.urgency && ", "}
                      {tooth.urgency && URGENCY_LABELS[tooth.urgency]}
                    </span>
                  )}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
