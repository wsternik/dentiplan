---
// "Odroczone" section (FR-062): out-of-current-plan teeth, clearly marked as
// outside the current plan. Default label "Odroczone" per PRD Open Q #5.
//
// Status is drawn, not coloured: this section sits on one muted surface and
// under a hatched rule, so it stays distinguishable in greyscale, in print, and
// to a reader who cannot separate red from green.
//
// Two things the first version of this got wrong, both found in review:
//
//   - The section and its descendants both carried dimming, and the two effects
//     multiplied below the contrast floor. The section now uses one muted
//     surface while the clinical text stays full-strength.
//   - The hatch is a `background-image`, and browsers suppress background images
//     in print unless the reader ticks "Background graphics" — while the print
//     block undims the section. On paper the deferred teeth would have looked
//     exactly like the ones in the plan, which is the single thing this section
//     exists to prevent. `print-color-adjust: exact` pins it, and the rule falls
//     back to a `double` border, which is a border and always prints.
//
// The section carries `aria-labelledby` pointing at its own `<h2>`: a
// `<section>` with no accessible name is not exposed as a landmark, and these
// three lists are how a patient using a screen reader navigates this document.

import type { ToothEntry } from "@/types";
import { toothName } from "@/lib/quote/tooth-name";

interface Props {
  teeth: ToothEntry[];
}

const { teeth } = Astro.props;
const sorted = [...teeth].sort((a, b) => a.number - b.number);
---

<section
  class="deferred border-border/80 bg-secondary/40 space-y-3 rounded-2xl border border-dashed p-5"
  aria-labelledby="odroczone-heading"
>
  <div>
    <h2 id="odroczone-heading" class="font-editorial text-2xl font-medium tracking-[-0.025em]">Odroczone</h2>
    <div class="hatched mt-2 h-1"></div>
  </div>
  <p class="text-sm">Te zęby nie są częścią bieżącego planu leczenia.</p>
  <ul class="max-w-[68ch] space-y-1.5 text-sm">
    {
      sorted.map((tooth) => (
        <li>
          {toothName(tooth.number)}
          {tooth.note && <span> — {tooth.note}</span>}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .hatched {
    background-image: repeating-linear-gradient(-45deg, var(--border) 0 1px, transparent 1px 5px);
    /* Browsers drop background images from print unless the reader ticks
       "Background graphics". Without this the hatch vanishes on paper. */
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  /* And if the reader's settings suppress backgrounds anyway, a border still
     draws — borders are never background-suppressed. This is the rule that
     actually guarantees deferred teeth stay distinguishable on paper. */
  @media print {
    .hatched {
      height: 0;
      border-top: 3px double var(--border);
    }
  }
</style>
