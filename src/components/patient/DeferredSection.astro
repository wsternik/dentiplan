---
// "Odroczone" section (FR-062): out-of-current-plan teeth, clearly marked as
// outside the current plan. Default label "Odroczone" per PRD Open Q #5.

import type { ToothEntry } from "@/types";
import { toothName } from "@/lib/quote/tooth-name";

interface Props {
  teeth: ToothEntry[];
}

const { teeth } = Astro.props;
const sorted = [...teeth].sort((a, b) => a.number - b.number);
---

<section class="space-y-2">
  <h2 class="text-lg font-semibold">Odroczone</h2>
  <p class="text-muted-foreground text-sm">Te zęby nie są częścią bieżącego planu leczenia.</p>
  <ul class="space-y-1 text-sm">
    {
      sorted.map((tooth) => (
        <li>
          <span class="font-medium">{toothName(tooth.number)}</span>
          {tooth.note && <span class="text-muted-foreground"> — {tooth.note}</span>}
        </li>
      ))
    }
  </ul>
</section>
